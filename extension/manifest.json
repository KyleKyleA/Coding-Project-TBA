{
  "manifest_version": 3,
  "name": "Focus & Study",
  "version": "0.1.0",
  "description": "Domain locking + study technique timers (Pomodoro, Feynman) in one focus session engine.",
  "permissions": ["storage", "alarms", "declarativeNetRequest"],
  "host_permissions": ["<all_urls>"],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Focus & Study"
  },
  "options_page": "options.html",
  "web_accessible_resources": [
    {
      "resources": ["blocked.html"],
      "matches": ["<all_urls>"]
    }
  ]
}
